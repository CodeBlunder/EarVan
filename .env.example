# Earvan Backend Configuration
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/earvan
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/earvan?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/earvan

